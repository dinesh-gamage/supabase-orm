{
  "name": "@dinesh-gamage/supabase-orm",
  "version": "0.1.0",
  "description": "Schema-as-code, safe auto-generated migrations, and typed data access for Supabase",
  "license": "MIT",
  "author": "Dinesh Gamage",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "supaorm": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.0.0"
  },
  "dependencies": {
    "commander": "^13.0.0",
    "dotenv": "^16.4.0",
    "jiti": "^2.4.0"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.78.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
